---
// FAQ (not in the v3 design; added 2026-11-23 for AEO, see BUILD_PLAN Decisions).
// Native <details>: no JS, and every answer is in the static HTML for crawlers.
import { site } from '../data/site';
const t = site.faqSection;
---
{site.faq.length > 0 && (
  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="cols">
      <div class="sticky">
        <h2 id="faq-title" class="h2">{t.h2}</h2>
        <p class="body">{t.intro}</p>
      </div>
      <div class="list">
        {site.faq.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3><span class="icon" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .section { max-width: var(--container); margin: 0 auto; padding: 112px var(--gutter); border-top: 1px solid var(--c-line); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 48px; align-items: start; }
  .sticky { position: sticky; top: 100px; }
  .h2 { margin-bottom: 16px; }
  .body { margin: 0; font-size: 17px; color: var(--c-muted); line-height: 1.65; max-width: 440px; }
  .list { border-top: 1px solid var(--c-line-2); }
  details { border-bottom: 1px solid var(--c-line-2); }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: var(--touch); padding: 22px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  h3 { margin: 0; font-size: 20px; font-weight: 700; line-height: 1.3; transition: color var(--t-fast); }
  summary:hover h3 { color: var(--c-accent-deep); }
  .icon { position: relative; flex: none; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--c-line-2); transition: border-color var(--t-fast), background var(--t-fast); }
  .icon::before, .icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; background: var(--c-ink); transform: translate(-50%, -50%); transition: transform var(--t-fast); }
  .icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .icon { background: var(--c-accent); border-color: var(--c-accent); }
  details[open] .icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  summary:hover .icon { border-color: var(--c-line-hover); }
  details p { margin: -6px 0 0; padding: 0 56px 24px 0; font-size: 16px; color: var(--c-muted); line-height: 1.6; max-width: 620px; }
  @media (max-width: 767.98px) {
    .section { padding-top: 72px; padding-bottom: 72px; }
    .sticky { position: static; }
    h3 { font-size: 18px; }
    details p { padding-right: 0; }
  }
</style>
