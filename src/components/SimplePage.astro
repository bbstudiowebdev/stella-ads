---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props { title: string; description?: string; noindex?: boolean; heading: string; accent?: boolean }
const { title, description, noindex = true, heading, accent = false } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <Nav />
  <main id="main" class="page">
    <div class="inner">
      <h1 class:list={{ accent }}>{heading}</h1>
      <slot />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page { background: var(--c-dark); color: #fff; min-height: 70vh; }
  .inner { max-width: 760px; margin: 0 auto; padding: var(--band-pad) var(--gutter); display: flex; flex-direction: column; gap: 16px; }
  h1 { margin: 0; font-size: clamp(32px, 5vw, 48px); font-weight: 800; line-height: 1.05; letter-spacing: -0.01em; }
  h1.accent { color: var(--c-accent); }
  .inner :global(p), .inner :global(li) { font-size: 17px; color: var(--c-muted-dark-2); line-height: 1.6; margin: 0; }
  .inner :global(h2) { margin: 24px 0 0; font-size: 22px; font-weight: 700; }
  .inner :global(ul) { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .inner :global(a:not(.btn-primary)) { color: #fff; }
  .inner :global(a:not(.btn-primary):hover) { color: var(--c-accent); }
  .inner :global(.btn-primary) { align-self: flex-start; margin-top: 12px; }
</style>
